      "text": "ORDERITEMS\n{\n  _id: UUID,\n\n  orderId: UUID,   \n  productId: UUID,  \n\n  // Product snapshot\n  productName: String,\n  model: String,\n  image: String,\n  price: Number,\n\n  quantity: Number,\n  discount: Number,\n  deliveryCharges: Number,\n\n  status:\n    \"pending\" |\n    \"processing\" |\n    \"shipped\" |\n    \"fulfilled\" |\n    \"cancelled\",\n\n  createdAt: Date,\n  updatedAt: Date\n}",
